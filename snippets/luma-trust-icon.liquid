{% comment %}
  Line icons for luma-trust-badges. Accepts: icon {String}
{% endcomment %}
{%- if icon != 'none' and icon != blank -%}
  <svg class="luma-trust__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {%- case icon -%}
      {%- when 'doctor' -%}
        <path d="M6 3v5a4 4 0 0 0 8 0V3"/><path d="M5 3h2M13 3h2"/><path d="M10 12v2a5 5 0 0 0 10 0v-2"/><circle cx="20" cy="10" r="2"/>
      {%- when 'droplet' -%}
        <path d="M12 3s-6 7-6 11a6 6 0 0 0 12 0c0-4-6-11-6-11z"/><path d="M9.5 14.5l1.8 1.8 3.4-3.6"/>
      {%- when 'leaf' -%}
        <path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14z"/><path d="M5 19l7-7"/>
      {%- when 'recycle' -%}
        <path d="M7 19H4.5a1.5 1.5 0 0 1-1.3-2.25L6 12"/><path d="M11 19h8.5a1.5 1.5 0 0 0 1.3-2.25L19 13.5"/><path d="M14.5 6.5l-1.2-2a1.5 1.5 0 0 0-2.6 0L8.5 8.3"/><path d="M9 16l2 3-2 3"/><path d="M4 9.5l2.5 2.5L9.5 11"/><path d="M17.5 9.5l1.5 3.5-3.5 1"/>
      {%- when 'india' -%}
        <path d="M12 21s-6-5.5-6-11a6 6 0 0 1 12 0c0 5.5-6 11-6 11z"/><circle cx="12" cy="10" r="2.2"/>
      {%- when 'shield' -%}
        <path d="M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/>
      {%- when 'sparkle' -%}
        <path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3z"/><path d="M19 16l.7 1.8 1.8.7-1.8.7L19 21l-.7-1.8-1.8-.7 1.8-.7L19 16z"/>
      {%- when 'bottle' -%}
        <path d="M10 2h4v3l2 3v12a2 2 0 0 1-2 2h-4a2 2 0 0 1-2-2V8l2-3V2z"/><path d="M4 20L20 4"/>
    {%- endcase -%}
  </svg>
{%- endif -%}

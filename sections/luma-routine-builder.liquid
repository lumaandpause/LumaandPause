{{ 'section-luma-routine-builder.css' | asset_url | stylesheet_tag }}
<script src="{{ 'luma-routine-builder.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- comment -%}
  Routine Builder: pick up to N concerns, get a purchasable routine.

  How a routine is resolved (assets/luma-routine-builder.js does it live):
  each concern tile carries a weight vector with one number per Product slot,
  in block order. The selected tiles' vectors are summed, and each slot is then
  core (in the routine and the cart), optional (offered as "worth adding") or
  hidden. The vectors are copied from the Luma Pause wellness quiz's main-concern
  question so the two entry points can never disagree.

  Rendered Liquid-first. Every tile and every product row exists in the markup
  and the server paints the complete ritual with a working native multi-line
  cart form, so with JavaScript off this is still a readable, purchasable
  section. The script only hides, shows and re-tiers what is already here, and
  hangs its motion off `.luma-routine--live`.
{%- endcomment -%}

{%- liquid
  assign slots = section.blocks | where: 'type', 'product'
  assign concerns = section.blocks | where: 'type', 'concern'

  assign server_total = 0
  assign server_count = 0
  assign states = ''

  for block in slots
    assign p = block.settings.product
    assign v = p.selected_or_first_available_variant
    assign state = 'ok'
    if p == blank or v == blank
      assign state = 'missing'
    elsif p.requires_selling_plan
      assign state = 'link_only'
    elsif p.has_only_default_variant == false
      assign state = 'link_only'
    elsif v.available == false
      assign state = 'sold_out'
    endif

    if state == 'ok'
      assign server_total = server_total | plus: v.price
      assign server_count = server_count | plus: 1
    endif

    assign states = states | append: state
    unless forloop.last
      assign states = states | append: ','
    endunless
  endfor

  assign states = states | split: ','

  assign cap = section.settings.selection_cap
  if cap > concerns.size
    assign cap = concerns.size
  endif

  if server_count == 1
    assign server_button = section.settings.add_all_label_single
  else
    assign server_button = section.settings.add_all_label | replace: '{count}', server_count
  endif

  if server_count == 1
    assign server_count_label = section.settings.count_label_single
  else
    assign server_count_label = section.settings.count_label | replace: '{count}', server_count
  endif

  comment
    Every {placeholder} substitution happens here, inside the liquid tag.
    Liquid's tokenizer ends an output tag at its first closing brace, so
    replace: '{steps}' written inside double braces cuts the tag short and the
    whole section fails to upload.
  endcomment
  assign server_heading = section.settings.result_heading_empty | replace: '{steps}', server_count
  assign server_counter = section.settings.counter_label | replace: '{selected}', 0 | replace: '{max}', cap
-%}

{%- if slots.size > 0 and concerns.size > 0 -%}
  <section
    class="luma-routine color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
    data-luma-routine
    data-section-id="{{ section.id }}"
  >
    <span class="luma-routine__glow" aria-hidden="true"></span>

    <div class="luma-routine__layout page-width">
      <div class="luma-routine__picker">
        <div class="luma-routine__header" data-animate="fade-up">
          {%- if section.settings.eyebrow != blank -%}
            <p class="luma-routine__eyebrow">
              <span class="luma-routine__eyebrow-dot" aria-hidden="true"></span>
              {{ section.settings.eyebrow | escape }}
            </p>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="luma-routine__heading">{{ section.settings.heading }}</h2>
          {%- endif -%}

          {%- if section.settings.text != blank -%}
            <div class="luma-routine__text">{{ section.settings.text }}</div>
          {%- endif -%}
        </div>

        <fieldset
          class="luma-routine__concerns"
          data-luma-routine-concerns
          aria-describedby="LumaRoutineCounter-{{ section.id }}"
        >
          <legend class="visually-hidden">{{ section.settings.concerns_legend | escape }}</legend>

          <div class="luma-routine__tiles" data-animate="stagger">
            {%- for block in concerns -%}
              {%- liquid
                assign i = forloop.index0
                assign tile_number = forloop.index
                if tile_number < 10
                  assign tile_number = tile_number | prepend: '0'
                endif

                assign raw = block.settings.weights | default: '' | split: ','
                assign weights = ''
                for slot in slots
                  assign n = raw[forloop.index0] | strip | plus: 0
                  assign weights = weights | append: n
                  unless forloop.last
                    assign weights = weights | append: ','
                  endunless
                endfor
              -%}

              <div class="luma-routine__tile-wrap" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
                <input
                  type="checkbox"
                  class="luma-routine__check visually-hidden"
                  id="LumaRoutineConcern-{{ section.id }}-{{ i }}"
                  data-luma-routine-concern
                  data-index="{{ i }}"
                  data-weights="{{ weights }}"
                  data-label="{{ block.settings.label | escape }}"
                >
                <label class="luma-routine__tile" for="LumaRoutineConcern-{{ section.id }}-{{ i }}">
                  <span class="luma-routine__tile-top" aria-hidden="true">
                    <span class="luma-routine__tile-index">{{ tile_number }}</span>
                    <span class="luma-routine__tile-mark"></span>
                  </span>

                  {%- if block.settings.image != blank or block.settings.glyph != 'none' -%}
                    <span class="luma-routine__tile-glyph" aria-hidden="true">
                      {%- if block.settings.image != blank -%}
                        {{
                          block.settings.image
                          | image_url: width: 176
                          | image_tag: loading: 'lazy', widths: '88, 176', sizes: '44px', alt: ''
                        }}
                      {%- else -%}
                        {%- render 'luma-routine-glyph', glyph: block.settings.glyph -%}
                      {%- endif -%}
                    </span>
                  {%- endif -%}

                  <span class="luma-routine__tile-label">{{ block.settings.label | escape }}</span>
                  {%- if block.settings.sub_label != blank -%}
                    <span class="luma-routine__tile-sub">{{ block.settings.sub_label | escape }}</span>
                  {%- endif -%}
                </label>

                {%- if request.design_mode and raw.size != slots.size -%}
                  <p class="luma-routine__editor-note">
                    "{{ block.settings.label | escape }}" has {{ raw.size }} weights but there are {{ slots.size }}
                    Product slots. Missing numbers count as 0 and extra ones are ignored.
                  </p>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>

          <div class="luma-routine__meta-row">
            <p class="luma-routine__counter" id="LumaRoutineCounter-{{ section.id }}" data-luma-routine-counter>
              {{- server_counter | escape -}}
            </p>
            <button type="button" class="luma-routine__clear" data-luma-routine-clear hidden>
              {{- section.settings.clear_label | escape -}}
            </button>
          </div>
        </fieldset>
      </div>

      <div class="luma-routine__card" data-animate="fade-up" data-luma-routine-card>
        <div class="luma-routine__card-top">
          <p class="luma-routine__card-eyebrow">{{ section.settings.result_eyebrow | escape }}</p>
          <p class="luma-routine__count">
            <span data-luma-routine-count>{{ server_count_label | escape }}</span>
          </p>
        </div>

        <h3
          class="luma-routine__card-heading"
          id="LumaRoutineHeading-{{ section.id }}"
          tabindex="-1"
          data-luma-routine-heading
        >
          {{- server_heading | escape -}}
        </h3>

        <p class="luma-routine__prompt" data-luma-routine-prompt>
          <svg class="luma-routine__prompt-arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
            <path d="M13 8H3m4-4L3 8l4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>{{ section.settings.result_prompt | escape }}</span>
        </p>

        <ul class="luma-routine__reasons" data-luma-routine-reasons>
          {%- for block in concerns -%}
            {%- if block.settings.reason != blank -%}
              <li class="luma-routine__reason" data-luma-routine-reason="{{ forloop.index0 }}" hidden>
                <span class="luma-routine__reason-tick" aria-hidden="true"></span>
                <span><strong>{{ block.settings.label | escape }}</strong> — {{ block.settings.reason | escape }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        <div class="luma-routine__steps-wrap" data-luma-routine-steps-wrap>
          <span class="luma-routine__rail" data-luma-routine-rail aria-hidden="true">
            <span class="luma-routine__rail-track"></span>
            <span class="luma-routine__rail-fill" data-luma-routine-rail-fill></span>
          </span>

          <ol class="luma-routine__steps" data-luma-routine-steps>
            {%- for block in slots -%}
              {%- render 'luma-routine-step',
                block: block,
                index0: forloop.index0,
                state: states[forloop.index0],
                section: section
              -%}
            {%- endfor -%}
          </ol>
        </div>

        <form
          class="luma-routine__foot"
          id="LumaRoutineForm-{{ section.id }}"
          method="post"
          action="{{ routes.cart_add_url }}"
          data-luma-routine-form
        >
          <input type="hidden" name="form_type" value="product">
          <input type="hidden" name="utf8" value="✓">
          {%- for block in slots -%}
            {%- if states[forloop.index0] == 'ok' -%}
              {%- assign v = block.settings.product.selected_or_first_available_variant -%}
              <input
                type="hidden"
                name="items[{{ forloop.index0 }}][id]"
                value="{{ v.id }}"
                data-luma-routine-line
                data-slot="{{ forloop.index0 }}"
              >
              <input
                type="hidden"
                name="items[{{ forloop.index0 }}][quantity]"
                value="1"
                data-luma-routine-qty
                data-slot="{{ forloop.index0 }}"
              >
            {%- endif -%}
          {%- endfor -%}
          <input type="hidden" name="return_to" value="{{ routes.cart_url }}">

          <div class="luma-routine__total-row">
            <span class="luma-routine__total-label">{{ section.settings.total_label | escape }}</span>
            <span class="luma-routine__total" data-luma-routine-total>{{ server_total | money }}</span>
          </div>

          <button
            type="submit"
            class="luma-routine__submit"
            data-luma-routine-submit
            data-luma-routine-primary
            {% if server_count == 0 %}
              aria-disabled="true"
            {% endif %}
          >
            <span data-luma-routine-submit-label>
              {%- if server_count == 0 -%}
                {{ section.settings.unavailable_all_label | escape }}
              {%- else -%}
                {{ server_button | escape }}
              {%- endif -%}
            </span>
            <svg class="luma-routine__submit-arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
              <path d="M3 8h10m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <svg class="luma-routine__submit-tick" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
              <path d="m3.5 8.5 3 3 6-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="luma-routine__spinner" aria-hidden="true"></span>
          </button>

          <p class="luma-routine__error" data-luma-routine-error role="alert" hidden></p>

          {%- if section.settings.cross_link_url != blank and section.settings.cross_link_label != blank -%}
            <a class="luma-routine__cross" href="{{ section.settings.cross_link_url }}">
              {{- section.settings.cross_link_label | escape }}
              <span aria-hidden="true">→</span>
            </a>
          {%- endif -%}
        </form>
      </div>
    </div>

    <p class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-luma-routine-status></p>

    {%- if section.settings.show_mobile_sheet -%}
      {%- comment -%}
        Live routine sheet, below 990px only.

        On a phone the card sits below the tiles, so picking a concern would
        otherwise change nothing the visitor can see. This sheet slides up on the
        first pick and mirrors the card live: a one-row peek (thumbnails, title,
        total, add to cart) that expands into the full routine.

        It never keeps its own state. Its rows, reasons and toggles are driven by
        the same resolve pass as the card, and its button submits the card's own
        form through the `form` attribute, so the two can never disagree about
        what gets added.

        Rendered inert and hidden; the script shows it while a concern is picked,
        the section is on screen and the card's own button is not. Kept outside
        the animated card so no transformed ancestor can trap position: fixed.
      {%- endcomment -%}
      <div class="luma-routine__sheet" data-luma-routine-sheet data-expanded="false" aria-hidden="true" inert>
        <span class="luma-routine__sheet-backdrop" data-luma-routine-sheet-backdrop aria-hidden="true"></span>

        <div class="luma-routine__sheet-panel" role="region" aria-label="{{ section.settings.result_eyebrow | escape }}">
          <button
            type="button"
            class="luma-routine__sheet-handle"
            data-luma-routine-sheet-toggle
            aria-expanded="false"
            aria-controls="LumaRoutineSheetBody-{{ section.id }}"
          >
            <span class="luma-routine__sheet-grip" aria-hidden="true"></span>
            <span class="visually-hidden" data-luma-routine-sheet-toggle-label>
              {{- section.settings.sheet_expand_label | escape -}}
            </span>
          </button>

          <div class="luma-routine__sheet-peek">
            <span class="luma-routine__sheet-thumbs" data-luma-routine-sheet-expand aria-hidden="true">
              {%- for block in slots -%}
                {%- assign p = block.settings.product -%}
                <span class="luma-routine__sheet-thumb" data-luma-routine-sheet-thumb data-slot="{{ forloop.index0 }}">
                  {%- if p.featured_media -%}
                    {{
                      p.featured_media
                      | image_url: width: 96
                      | image_tag: loading: 'lazy', widths: '72, 96', sizes: '36px', alt: ''
                    }}
                  {%- endif -%}
                </span>
              {%- endfor -%}
            </span>

            <span class="luma-routine__sheet-summary" data-luma-routine-sheet-expand>
              <span class="luma-routine__sheet-title" data-luma-routine-sheet-title>{{ server_heading | escape }}</span>
              <span class="luma-routine__sheet-total" data-luma-routine-sheet-total>{{ server_total | money }}</span>
            </span>

            <button
              type="submit"
              form="LumaRoutineForm-{{ section.id }}"
              class="luma-routine__submit luma-routine__sheet-submit"
              data-luma-routine-submit
              data-label-mode="short"
            >
              <span data-luma-routine-submit-label>{{ section.settings.sheet_add_label | escape }}</span>
              <svg class="luma-routine__submit-tick" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                <path d="m3.5 8.5 3 3 6-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span class="luma-routine__spinner" aria-hidden="true"></span>
            </button>
          </div>

          <p class="luma-routine__error luma-routine__sheet-error" data-luma-routine-error role="alert" hidden></p>

          <div
            class="luma-routine__sheet-body"
            id="LumaRoutineSheetBody-{{ section.id }}"
            data-luma-routine-sheet-body
            hidden
          >
            <ul class="luma-routine__reasons">
              {%- for block in concerns -%}
                {%- if block.settings.reason != blank -%}
                  <li class="luma-routine__reason" data-luma-routine-reason="{{ forloop.index0 }}" hidden>
                    <span class="luma-routine__reason-tick" aria-hidden="true"></span>
                    <span><strong>{{ block.settings.label | escape }}</strong> — {{ block.settings.reason | escape }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

            <ol class="luma-routine__sheet-rows">
              {%- for block in slots -%}
                {%- liquid
                  assign p = block.settings.product
                  assign v = p.selected_or_first_available_variant
                  assign state = states[forloop.index0]
                  assign title = block.settings.title | default: p.title | default: block.settings.phase
                -%}
                <li
                  class="luma-routine__sheet-row"
                  data-luma-routine-sheet-row
                  data-slot="{{ forloop.index0 }}"
                  data-tier="core"
                  data-state="{{ state }}"
                >
                  <span class="luma-routine__thumb" aria-hidden="true">
                    {%- if p.featured_media -%}
                      {{
                        p.featured_media
                        | image_url: width: 120
                        | image_tag: loading: 'lazy', widths: '88, 120', sizes: '44px', alt: ''
                      }}
                    {%- endif -%}
                  </span>
                  <span class="luma-routine__sheet-row-body">
                    <span class="luma-routine__phase">
                      <span>{{ block.settings.phase | escape }} · {{ block.settings.cadence | escape }}</span>
                      <span class="luma-routine__badge" data-luma-routine-badge hidden>
                        {{- section.settings.result_optional_label | escape -}}
                      </span>
                    </span>
                    <span class="luma-routine__title">
                      {%- if p != blank -%}
                        <a href="{{ p.url }}">{{ title | escape }}</a>
                      {%- else -%}
                        {{ title | escape }}
                      {%- endif -%}
                    </span>
                  </span>
                  <span class="luma-routine__aside">
                    {%- case state -%}
                      {%- when 'ok' -%}
                        <span class="luma-routine__price">{{ v.price | money }}</span>
                      {%- when 'sold_out' -%}
                        <span class="luma-routine__soldout">{{ section.settings.sold_out_label | escape }}</span>
                    {%- endcase -%}
                    {%- if state == 'ok' -%}
                      <button
                        type="button"
                        class="luma-routine__toggle"
                        data-luma-routine-optional-toggle
                        aria-pressed="false"
                        hidden
                      >
                        <span class="luma-routine__toggle-plus" aria-hidden="true">+</span>
                        <span class="luma-routine__toggle-tick" aria-hidden="true"></span>
                        <span data-luma-routine-toggle-label>{{ section.settings.optional_add_label | escape }}</span>
                        <span class="visually-hidden">{{ title | escape }}</span>
                      </button>
                    {%- endif -%}
                  </span>
                </li>
              {%- endfor -%}
            </ol>
          </div>
        </div>
      </div>
    {%- endif -%}

    <script type="application/json" data-luma-routine-config>
      {
        "threshold": {{ section.settings.core_threshold | json }},
        "cap": {{ cap | json }},
        "showOptional": {{ section.settings.show_optional | json }},
        "moneyFormat": {{ shop.money_format | json }},
        "labels": {
          "heading": {{ section.settings.result_heading | json }},
          "headingSingle": {{ section.settings.result_heading_single | json }},
          "headingEmpty": {{ section.settings.result_heading_empty | json }},
          "count": {{ section.settings.count_label | json }},
          "countSingle": {{ section.settings.count_label_single | json }},
          "addAll": {{ section.settings.add_all_label | json }},
          "addAllSingle": {{ section.settings.add_all_label_single | json }},
          "adding": {{ section.settings.adding_label | json }},
          "added": {{ section.settings.added_label | json }},
          "unavailableAll": {{ section.settings.unavailable_all_label | json }},
          "optionalAdd": {{ section.settings.optional_add_label | json }},
          "optionalAdded": {{ section.settings.optional_added_label | json }},
          "counter": {{ section.settings.counter_label | json }},
          "counterCap": {{ section.settings.counter_cap_label | json }},
          "capNotice": {{ section.settings.cap_notice | json }},
          "total": {{ section.settings.total_label | json }},
          "error": {{ section.settings.error_label | json }},
          "addedNotice": {{ section.settings.added_notice | json }},
          "sheetAdd": {{ section.settings.sheet_add_label | json }},
          "sheetExpand": {{ section.settings.sheet_expand_label | json }},
          "sheetCollapse": {{ section.settings.sheet_collapse_label | json }}
        }
      }
    </script>
  </section>
{%- elsif request.design_mode -%}
  <div class="page-width luma-routine__editor-empty">
    <p>
      Add at least one <strong>Product slot</strong> and one <strong>Concern tile</strong> block to build a
      routine.
    </p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Luma routine builder",
  "tag": "div",
  "class": "section luma-routine-section",
  "max_blocks": 16,
  "settings": [
    {
      "type": "paragraph",
      "content": "Visitors pick concerns and get a routine they can add to the cart in one go. Designed for the Soft Cream colour schemes - the tiles and routine card are light surfaces."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "What are you <strong>feeling right now?</strong>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "concerns_legend",
      "label": "Concerns group name",
      "info": "Not shown. Read out by screen readers before the tiles.",
      "default": "Your wellness concerns"
    },
    {
      "type": "text",
      "id": "counter_label",
      "label": "Selection counter",
      "info": "{selected} and {max} are replaced with numbers.",
      "default": "{selected} of {max} selected"
    },
    {
      "type": "text",
      "id": "counter_cap_label",
      "label": "Selection counter at the limit",
      "default": "{max} of {max} · deselect one to swap"
    },
    {
      "type": "text",
      "id": "cap_notice",
      "label": "Limit reached message",
      "info": "Announced to screen readers when someone tries to pick one more than the limit.",
      "default": "You can pick up to {max}. Deselect one to swap."
    },
    {
      "type": "text",
      "id": "clear_label",
      "label": "Clear button",
      "default": "Clear"
    },
    {
      "type": "header",
      "content": "Routine card"
    },
    {
      "type": "text",
      "id": "result_eyebrow",
      "label": "Card eyebrow",
      "default": "Your routine"
    },
    {
      "type": "text",
      "id": "result_heading",
      "label": "Heading",
      "info": "{steps} is replaced with the number of steps.",
      "default": "Your {steps}-step ritual"
    },
    {
      "type": "text",
      "id": "result_heading_single",
      "label": "Heading for a single step",
      "info": "Used when the result is one step, where \"1-step ritual\" reads oddly.",
      "default": "Start with one step"
    },
    {
      "type": "text",
      "id": "result_heading_empty",
      "label": "Heading before anything is picked",
      "info": "Also what visitors without JavaScript see.",
      "default": "Your complete {steps}-step ritual"
    },
    {
      "type": "text",
      "id": "result_prompt",
      "label": "Prompt before anything is picked",
      "default": "Pick your concerns to tailor it. Until then, here's the complete ritual."
    },
    {
      "type": "text",
      "id": "count_label",
      "label": "Step count",
      "info": "{count} is replaced with the number of steps.",
      "default": "{count} steps"
    },

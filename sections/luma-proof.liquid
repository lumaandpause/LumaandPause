          }
        },
        {
          "type": "diary",
          "settings": {
            "day_label": "Day 1",
            "note": "One capsule with breakfast. Easy to remember.",
            "milestone": false
          }
        },
        {
          "type": "diary",
          "settings": {
            "day_label": "Day 30",
            "note": "Less bloating after meals.",
            "milestone": false
          }
        },
        {
          "type": "diary",
          "settings": {
            "day_label": "Day 60",
            "note": "Sleeping through more nights.",
            "milestone": true
          }
        },
        {

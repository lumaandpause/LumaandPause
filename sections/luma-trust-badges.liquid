{{ 'section-luma-trust-badges.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #LumaTrust-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    #LumaTrust-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div id="LumaTrust-{{ section.id }}" class="luma-trust color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="luma-trust__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <ul class="luma-trust__grid luma-trust__grid--{{ section.blocks.size }}" role="list" data-animate="stagger">
      {%- for block in section.blocks -%}
        <li class="luma-trust__item" {{ block.shopify_attributes }}>
          <span class="luma-trust__icon-wrap" aria-hidden="true">
            {%- if block.settings.icon != blank -%}
              {{
                block.settings.icon
                | image_url: width: 96
                | image_tag: loading: 'lazy', class: 'luma-trust__icon-img', alt: ''
              }}
            {%- else -%}
              {%- render 'luma-trust-icon', icon: block.settings.icon_type -%}
            {%- endif -%}
          </span>
          <div class="luma-trust__text">
            {%- if block.settings.label != blank -%}
              <p class="luma-trust__label">{{ block.settings.label | escape }}</p>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="luma-trust__desc">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Luma trust badges",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading (optional)"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icon",
          "options": [
            { "value": "doctor", "label": "Doctor / stethoscope" },
            { "value": "droplet", "label": "Droplet (lightweight)" },
            { "value": "leaf", "label": "Leaf (gentle / natural)" },
            { "value": "recycle", "label": "Recycle" },
            { "value": "india", "label": "Made in India" },
            { "value": "shield", "label": "Shield (safe)" },
            { "value": "sparkle", "label": "Sparkle (glow)" },
            { "value": "bottle", "label": "Bottle (sulfate-free)" },
            { "value": "none", "label": "None" }
          ],
          "default": "doctor"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Custom icon image",
          "info": "Optional. Replaces the icon above."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Title",
          "default": "Doctor Formulated"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Short description",
          "default": "Developed with dermatology expertise"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Luma trust badges",
      "blocks": [
        { "type": "badge", "settings": { "icon_type": "doctor", "label": "Doctor Formulated", "text": "Developed with dermatology expertise" } },
        { "type": "badge", "settings": { "icon_type": "droplet", "label": "Lightweight & Non-Sticky", "text": "Absorbs fast, never feels heavy" } },
        { "type": "badge", "settings": { "icon_type": "recycle", "label": "Recyclable Packaging", "text": "Kinder to the planet" } },
        { "type": "badge", "settings": { "icon_type": "india", "label": "Made in India", "text": "Proudly formulated & made here" } }
      ]
    }
  ]
}
{% endschema %}

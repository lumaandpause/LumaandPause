{{ 'section-luma-results.css' | asset_url | stylesheet_tag }}

<section class="luma-pdp-results color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="luma-pdp-results__inner">
      <div class="luma-pdp-results__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="luma-pdp-results__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="luma-pdp-results__title">{{ section.settings.heading }}</h2>
        <p class="luma-pdp-results__desc">Based on a 12-week self-reported customer survey of 120 women in perimenopause and menopause taking one capsule daily.</p>
        
        <div class="luma-pdp-results__guarantee">
          <svg class="luma-pdp-results__guarantee-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>Formulated with Clinically Studied Strains</span>
        </div>
      </div>

      <div class="luma-pdp-results__stats">
        <div class="luma-pdp-results__stat-item">
          <div class="luma-pdp-results__stat-head">
            <span class="luma-pdp-results__stat-val">89%</span>
            <span class="luma-pdp-results__stat-label">Reported Less Bloating After Meals</span>
          </div>
          <div class="luma-pdp-results__bar"><div class="luma-pdp-results__fill" style="width: 89%;"></div></div>
        </div>

        <div class="luma-pdp-results__stat-item">
          <div class="luma-pdp-results__stat-head">
            <span class="luma-pdp-results__stat-val">92%</span>
            <span class="luma-pdp-results__stat-label">Reported More Restful Sleep</span>
          </div>
          <div class="luma-pdp-results__bar"><div class="luma-pdp-results__fill" style="width: 92%;"></div></div>
        </div>

        <div class="luma-pdp-results__stat-item">
          <div class="luma-pdp-results__stat-head">
            <span class="luma-pdp-results__stat-val">95%</span>
            <span class="luma-pdp-results__stat-label">Found the Daily Capsule Easy to Stick With</span>
          </div>
          <div class="luma-pdp-results__bar"><div class="luma-pdp-results__fill" style="width: 95%;"></div></div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Luma clinical results",
  "tag": "section",
  "class": "section luma-product-results-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "CUSTOMER SURVEY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real Results Women Can Feel"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Luma clinical results"
    }
  ]
}
{% endschema %}

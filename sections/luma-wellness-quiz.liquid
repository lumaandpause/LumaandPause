        {
          "type": "text",
          "id": "opt2_sub",
          "label": "Sub-label"
        },
        {
          "type": "text",
          "id": "opt2_weights",
          "label": "Points",
          "default": "0,0,0"
        },
        {
          "type": "text",
          "id": "opt2_reason",
          "label": "Reason clause"
        },
        {
          "type": "header",
          "content": "Option 3"
        },
        {
          "type": "text",
          "id": "opt3_label",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "opt3_sub",
          "label": "Sub-label"
        },
        {
          "type": "text",
          "id": "opt3_weights",
          "label": "Points",
          "default": "0,0,0"
        },
        {
          "type": "text",
          "id": "opt3_reason",
          "label": "Reason clause"
        },
        {
          "type": "header",
          "content": "Option 4"
        },
        {
          "type": "text",
          "id": "opt4_label",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "opt4_sub",
          "label": "Sub-label"
        },
        {
          "type": "text",
          "id": "opt4_weights",
          "label": "Points",
          "default": "0,0,0"
        },
        {
          "type": "text",
          "id": "opt4_reason",
          "label": "Reason clause"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Luma Pause wellness quiz",
      "blocks": [
        {
          "type": "product",

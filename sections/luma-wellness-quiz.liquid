<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Geist:wght@400;600;700;800&family=Geist+Mono:wght@600;700&display=swap"
  rel="stylesheet"
>
{{ 'section-luma-wellness-quiz.css' | asset_url | stylesheet_tag }}
<script src="{{ 'luma-wellness-quiz.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="luma-wellness-quiz color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="luma-wellness-quiz__header" data-animate="fade-up">
        {%- if section.settings.eyebrow != blank -%}
          <p class="luma-wellness-quiz__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="luma-wellness-quiz__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="luma-wellness-quiz__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {% render 'luma-wellness-quiz-steps', section: section, context: 'page' %}
  </div>
</div>

{% schema %}
{
  "name": "Luma Pause wellness quiz",
  "tag": "section",
  "class": "section luma-wellness-quiz-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "60-second wellness quiz"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Find your probiotic. <strong>Made for the pause.</strong>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Four questions about your life stage, your gut and your routine. We'll match you to the probiotic made for what your body is going through — and show you exactly why.</p>"
    },
    {
      "type": "text",
      "id": "back_label",
      "label": "Back button label",
      "default": "Back"
    },
    {
      "type": "header",
      "content": "Results screen"
    },
    {
      "type": "text",
      "id": "result_eyebrow",
      "label": "Result eyebrow",
      "default": "Your result"
    },
    {
      "type": "text",
      "id": "result_heading",
      "label": "Result heading",
      "default": "Your best match"
    },
    {
      "type": "textarea",
      "id": "result_text",
      "label": "Result intro text",
      "default": "Based on what you told us, here's where to start — and the reasoning behind it."
    },
    {
      "type": "text",
      "id": "result_supporting_label",
      "label": "Supporting products label",
      "default": "Complete your ritual"
    },
    {
      "type": "header",
      "content": "Doctor recommendation"
    },
    {
      "type": "checkbox",
      "id": "doctor_enabled",
      "label": "Show doctor block on results",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "doctor_image",
      "label": "Doctor photo",
      "info": "Square image works best. A placeholder shows until you upload one."
    },
    {
      "type": "text",
      "id": "doctor_badge",
      "label": "Badge text",
      "default": "Doctor recommended"
    },
    {
      "type": "textarea",
      "id": "doctor_quote",
      "label": "Quote",
      "default": "So many of the menopause concerns I see — bloating, mood, intimate discomfort — are linked to changes in the microbiome. Supporting it daily is a simple, gentle place to start."
    },
    {
      "type": "text",
      "id": "doctor_name",
      "label": "Doctor name",
      "default": "Dr. [Name]"
    },
    {
      "type": "text",
      "id": "doctor_role",
      "label": "Position / qualification",
      "default": "[Position, qualification]"
    },
    {
      "type": "textarea",
      "id": "doctor_disclaimer",
      "label": "Disclaimer",
      "info": "Keep a factual disclaimer here. These are cosmetic products and the test is not a medical diagnosis.",
      "default": "This quiz suggests food supplements based on your answers. It is not a medical diagnosis. For persistent or severe symptoms, please consult your doctor or gynaecologist."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product slot",
      "settings": [
        {
          "type": "paragraph",
          "content": "The ORDER of these Product blocks defines the weight positions used in every question. Slot 1 is the first number, slot 2 the second, and so on."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Display name",
          "info": "Leave blank to use the product's own title."
        },
        {
          "type": "text",
          "id": "axis",
          "label": "Concern it owns",
          "default": "Gut comfort & digestion"
        },
        {
          "type": "textarea",
          "id": "hero_line",
          "label": "Why this is the match",
          "info": "Shown only when this product is the top result.",
          "default": "A calmer gut, every day."
        }
      ]
    },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Step label",
          "default": "About you"
        },
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What bothers you most right now?"
        },
        {
          "type": "text",
          "id": "help",
          "label": "Helper text"
        },
        {
          "type": "range",
          "id": "weight",
          "min": 0,
          "max": 5,
          "step": 0.5,
          "label": "Question weight",
          "info": "How much this question counts. Use a high weight for the main concern and a low one (0.5) for questions that should only break ties.",
          "default": 2
        },
        {
          "type": "header",
          "content": "Option 1"
        },
        {
          "type": "text",
          "id": "opt1_label",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "opt1_sub",
          "label": "Sub-label"
        },
        {
          "type": "text",
          "id": "opt1_weights",
          "label": "Points",
          "info": "One number per Product slot, comma separated, in block order. Example: 0,3,1",
          "default": "0,0,0"
        },
        {
          "type": "text",
          "id": "opt1_reason",

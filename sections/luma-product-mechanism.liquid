{{ 'section-luma-mechanism.css' | asset_url | stylesheet_tag }}
<script src="{{ 'luma-mechanism.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="luma-mechanism color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding" data-section-id="{{ section.id }}">
  <div class="page-width">
    <!-- Header -->
    <div class="luma-mechanism__header" data-mechanism-header>
      {%- if section.settings.eyebrow != blank -%}
        <p class="luma-mechanism__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="luma-mechanism__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="luma-mechanism__subtitle">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <!-- 4 Mechanism Cards Grid (Not Paragraphs) -->
    <div class="luma-mechanism__grid">
      <!-- Card 1: L. gasseri -->
      <div class="luma-mechanism__card" data-mechanism-card>
        <div class="luma-mechanism__card-top">
          <span class="luma-mechanism__badge">01 • 10B CFU</span>
          <div class="luma-mechanism__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
          </div>
        </div>

        <h3 class="luma-mechanism__name">L. gasseri</h3>
        <p class="luma-mechanism__role">Digestive Comfort Strain</p>

        <div class="luma-mechanism__block">
          <span class="luma-mechanism__label">HOW IT WORKS:</span>
          <p class="luma-mechanism__action">Colonises the gut lining and helps crowd out gas-producing bacteria linked to bloating.</p>
        </div>

        <div class="luma-mechanism__outcome-tag">
          <span class="luma-mechanism__outcome-icon">🎯</span>
          <span class="luma-mechanism__outcome-text"><strong>Supports:</strong> Days 1–30 Calmer Digestion</span>
        </div>
      </div>

      <!-- Card 2: B. longum -->
      <div class="luma-mechanism__card" data-mechanism-card>
        <div class="luma-mechanism__card-top">
          <span class="luma-mechanism__badge">02 • 10B CFU</span>
          <div class="luma-mechanism__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
        </div>

        <h3 class="luma-mechanism__name">B. longum</h3>
        <p class="luma-mechanism__role">Gut–Brain Axis Strain</p>

        <div class="luma-mechanism__block">
          <span class="luma-mechanism__label">HOW IT WORKS:</span>
          <p class="luma-mechanism__action">Supports the production of calming neurotransmitter precursors along the gut–brain axis.</p>
        </div>

        <div class="luma-mechanism__outcome-tag">
          <span class="luma-mechanism__outcome-icon">🎯</span>
          <span class="luma-mechanism__outcome-text"><strong>Supports:</strong> Days 31–60 Steadier Mood & Sleep</span>
        </div>
      </div>

      <!-- Card 3: Saffron -->
      <div class="luma-mechanism__card" data-mechanism-card>
        <div class="luma-mechanism__card-top">
          <span class="luma-mechanism__badge">03 • BOTANICAL</span>
          <div class="luma-mechanism__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
          </div>
        </div>

        <h3 class="luma-mechanism__name">Saffron Extract</h3>
        <p class="luma-mechanism__role">Menopause Comfort Botanical</p>

        <div class="luma-mechanism__block">
          <span class="luma-mechanism__label">HOW IT WORKS:</span>
          <p class="luma-mechanism__action">Supports emotional balance and comfort through the hormonal ups and downs of menopause.</p>
        </div>

        <div class="luma-mechanism__outcome-tag">
          <span class="luma-mechanism__outcome-icon">🎯</span>
          <span class="luma-mechanism__outcome-text"><strong>Supports:</strong> Fewer Mood Swings</span>
        </div>
      </div>

      <!-- Card 4: Inulin -->
      <div class="luma-mechanism__card" data-mechanism-card>
        <div class="luma-mechanism__card-top">
          <span class="luma-mechanism__badge">04 • PREBIOTIC</span>
          <div class="luma-mechanism__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
        </div>

        <h3 class="luma-mechanism__name">Inulin Fibre</h3>
        <p class="luma-mechanism__role">Microbiome Fuel</p>

        <div class="luma-mechanism__block">
          <span class="luma-mechanism__label">HOW IT WORKS:</span>
          <p class="luma-mechanism__action">Feeds beneficial bacteria so they can multiply and build a more diverse, resilient microbiome.</p>
        </div>

        <div class="luma-mechanism__outcome-tag">
          <span class="luma-mechanism__outcome-icon">🎯</span>
          <span class="luma-mechanism__outcome-text"><strong>Supports:</strong> Days 61–90+ Long-Term Balance</span>
        </div>
      </div>
    </div>

    <!-- Mobile Horizontal Carousel Navigation -->
    <div class="luma-mechanism__mobile-nav" data-mechanism-nav>
      <div class="luma-mechanism__dots" role="tablist" aria-label="Mechanism cards navigation">
        <button type="button" class="luma-mechanism__dot is-active" data-mechanism-dot="0" aria-label="Go to card 1"></button>
        <button type="button" class="luma-mechanism__dot" data-mechanism-dot="1" aria-label="Go to card 2"></button>
        <button type="button" class="luma-mechanism__dot" data-mechanism-dot="2" aria-label="Go to card 3"></button>
        <button type="button" class="luma-mechanism__dot" data-mechanism-dot="3" aria-label="Go to card 4"></button>
      </div>
      <span class="luma-mechanism__swipe-hint">Swipe to explore &rarr;</span>
    </div>

    <!-- Micro Summary Strip -->
    <div class="luma-mechanism__summary-strip" data-mechanism-summary>
      <span class="luma-mechanism__summary-badge">SYNERGISTIC MECHANISM</span>
      <p class="luma-mechanism__summary-text">
        Colonising + Calming + Balancing + Feeding work together to support your gut, mood and comfort through every stage of the pause.
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Luma Formula Mechanism",
  "tag": "section",
  "class": "section luma-mechanism-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE MECHANISM OF ACTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How Each Ingredient Supports You"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Every strain and botanical has a specific role in supporting your 90-day journey."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Luma Formula Mechanism"
    }
  ]
}
{% endschema %}

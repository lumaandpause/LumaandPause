{{ 'section-luma-how-to-use.css' | asset_url | stylesheet_tag }}

<section class="luma-pdp-how-to-use color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="luma-pdp-how-to-use__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="luma-pdp-how-to-use__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="luma-pdp-how-to-use__title">{{ section.settings.heading }}</h2>
      <p class="luma-pdp-how-to-use__subtitle">3 simple steps every day to get the most from your probiotic.</p>
    </div>

    <div class="luma-pdp-how-to-use__grid">
      <div class="luma-pdp-how-to-use__card">
        <span class="luma-pdp-how-to-use__step-num">STEP 01</span>
        <h3 class="luma-pdp-how-to-use__step-title">Take One Capsule</h3>
        <p class="luma-pdp-how-to-use__step-text">Swallow one capsule with a glass of water, ideally with breakfast or your evening meal.</p>
      </div>

      <div class="luma-pdp-how-to-use__card">
        <span class="luma-pdp-how-to-use__step-num">STEP 02</span>
        <h3 class="luma-pdp-how-to-use__step-title">Same Time Each Day</h3>
        <p class="luma-pdp-how-to-use__step-text">Pair it with a daily habit — your morning tea or brushing your teeth — so it becomes automatic.</p>
      </div>

      <div class="luma-pdp-how-to-use__card">
        <span class="luma-pdp-how-to-use__step-num">STEP 03</span>
        <h3 class="luma-pdp-how-to-use__step-title">Stay Consistent</h3>
        <p class="luma-pdp-how-to-use__step-text">Take it every day for at least 8–12 weeks. Your microbiome adapts gradually, and consistency matters most.</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Luma how to use ritual",
  "tag": "section",
  "class": "section luma-product-how-to-use-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "DAILY APPLICATION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The 3-Step Daily Ritual"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Luma how to use ritual"
    }
  ]
}
{% endschema %}
